	fragment@43 {
		target = <0xffffffff>;

		__overlay__ {

			nanosic_keyboard_mcu {

				xiaomi_keyboard_sleep_default {
					phandle = <0x30>;

					mux {
						pins = "gpio126";
						function = "gpio";
					};

					config {
						pins = "gpio126";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};

				xiaomi_keyboard_default {
					phandle = <0x31>;

					mux {
						pins = "gpio189\0gpio169";
						function = "gpio";
					};

					config {
						pins = "gpio189\0gpio169";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			mi_qupv3_se5_i2c_pins {
				phandle = <0x85>;

				mi_qupv3_se5_i2c_sda_active {
					phandle = <0x2d>;

					mux {
						pins = "gpio12";
						function = "qup1_se5_l0";
					};

					config {
						pins = "gpio12";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				mi_qupv3_se5_i2c_scl_active {
					phandle = <0x2e>;

					mux {
						pins = "gpio13";
						function = "qup1_se5_l1";
					};

					config {
						pins = "gpio13";
						drive-strength = <0x02>;
						bias-disable;
					};
				};

				mi_qupv3_se5_i2c_sleep {
					phandle = <0x2f>;

					mux {
						pins = "gpio12\0gpio13";
						function = "gpio";
					};

					config {
						pins = "gpio12\0gpio13";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};
		};
	};

