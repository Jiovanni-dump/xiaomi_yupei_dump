        <value_map threshold="3800000" ratio_value ="85,85,85,85" sthresh ="3920000,3920000,3920000,3920000" description="ad_hoc ratio"/>
        <value_map threshold="3650000" ratio_value ="80,80,80,80" sthresh ="3750000,3750000,3750000,3750000" description="ad_hoc ratio"/>
