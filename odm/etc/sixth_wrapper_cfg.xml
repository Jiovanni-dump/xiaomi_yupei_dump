<?xml version="1.0" encoding="UTF-8" ?>
<sixth_wrapper_config>
    <config_element name="sipa_ctl_prefix" spkr_0_ctl="SpkrLeft T" spkr_1_ctl="SpkrRight T" 
		spkr_2_ctl="SpkrLeft B" spkr_3_ctl="SpkrRight B" spkr_4_ctl="Spkr_ch_4" spkr_5_ctl="Spkr_ch_5" 
