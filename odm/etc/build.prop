#support dual wifi feature
ro.vendor.net.enable_dual_wifi=1
#logd buffer size
ro.logd.size=2M
# Set network mode to (NR_LTE_TDSCDMA_CDMA_EVDO_GSM_WCDMA, NR_LTE_TDSCDMA_CDMA_EVDO_GSM_WCDMA) for 8+8 mode device on DSDS mode
