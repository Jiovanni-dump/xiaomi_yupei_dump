#support wired reverse quickcharge
persist.vendor.reverse.quickcharge=true
#enable sensor event to onetrack
persist.vendor.sensor.onetrack=true
#enable device orient event to onetrack
persist.vendor.sensor.deviceorient=true
#enable sensor mis check
persist.vendor.sensor.mischeck=true
#support dfs
persist.vendor.tracking.dfs=true
#distinguish use "xiaomi-hall" or "gpio-keys"
persist.vendor.sensor.use_xiaomi_hall=true
#support sbms3.0 new display scheme of soh
persist.vendor.smart.battMntor.V2=true
#support night charge property
persist.vendor.night.charge=true
#support double ntc antiburn
persist.vendor.doublentc=1
#support smart charge engine 0b0 0001 0000
## enable endurance protect
persist.vendor.smartchg=16
#support battery erp data
persist.vendor.battery.erp=true
persist.vendor.region.charger=default
#support battery health
persist.vendor.battery.health=true
persist.vendor.battery.health.optimise=true
#support low cutoff
persist.vendor.low.cutoff=true
